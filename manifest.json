{
  "manifest_version": 3,
  "name": "AuraSolve — Practice Tutor",
  "version": "1.16.0",
  "description": "Explain questions, fill supported practice fields, and work through ungraded practice with a tutor.",
  "minimum_chrome_version": "141",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.up.railway.app/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "https://*.pearson.com/*",
    "https://*.mathxl.com/*",
    "https://*.mymathlab.com/*",
    "https://*.raydass.com/*",
    "http://localhost:4318/*",
    "http://127.0.0.1:4318/*"
  ],
  "background": {
    "service_worker": "src/background/worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open AuraSolve",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pearson.com/*",
        "https://*.mathxl.com/*",
        "https://*.mymathlab.com/*",
        "https://*.raydass.com/*",
        "http://localhost:4318/*",
        "http://127.0.0.1:4318/*"
      ],
      "js": [
        "src/content/bootstrap.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js",
        "src/content/*.css",
        "src/shared/*.js",
        "src/vendor/katex/*",
        "src/vendor/katex/fonts/*",
        "src/shared/*.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "src/popup/popup.html"
  }
}
