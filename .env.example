# Railway server (set these in Railway → Variables)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1
# Optional: signs per-install tokens (otherwise derived from OPENAI_API_KEY)
INSTALL_SECRET=generate-a-long-random-string

# Paywall: turns on as soon as STRIPE_SECRET_KEY is set. Prices and intro
# coupons are created in Stripe automatically on the first checkout.
STRIPE_SECRET_KEY=sk_live_or_sk_test_key
# Email and Google accounts. Postgres keeps the password hash and Google id.
DATABASE_URL=postgresql://user:password@host:5432/railway
# Google OAuth web client. Redirects:
# https://aurasolve.io/api/v1/auth/google/callback
# https://aurasolve-production.up.railway.app/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Password reset emails are sent with Resend (verify aurasolve.io there first)
RESEND_API_KEY=re_your_key
EMAIL_FROM=AuraSolve <login@aurasolve.io>
# Optional
FREE_SOLVES=5
PUBLIC_URL=https://aurasolve.io

# Local dev only
PORT=8787
