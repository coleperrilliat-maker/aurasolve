# Railway server (set these in Railway → Variables)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1
# Optional: signs per-install tokens (otherwise derived from OPENAI_API_KEY)
INSTALL_SECRET=generate-a-long-random-string

# Paywall: turns on as soon as STRIPE_SECRET_KEY is set. Prices and intro
# coupons are created in Stripe automatically on the first checkout.
STRIPE_SECRET_KEY=sk_live_or_sk_test_key
# Publishable key (pk_...) for the on-site embedded checkout at /pay
STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_key
# Stripe Dashboard → Webhooks → https://aurasolve.io/api/v1/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed, charge.dispute.created, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Email and Google accounts. Postgres keeps the password hash and Google id.
DATABASE_URL=postgresql://user:password@host:5432/railway
# Google OAuth web client. Redirects:
# https://aurasolve.io/api/v1/auth/google/callback
# https://aurasolve-production.up.railway.app/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Password reset emails are sent with Resend (verify aurasolve.io there first)
RESEND_API_KEY=re_your_key
EMAIL_FROM=AuraSolve <login@aurasolve.io>
# Optional
# Hard paywall: leave at 0 (or omit). Only set above 0 if you intentionally want free solves.
FREE_SOLVES=0
PUBLIC_URL=https://aurasolve.io

# PostHog AI Observability (LLM traces for solves/ask/forms). Project API key from
# PostHog → Project settings. Leave unset to keep tracing off.
POSTHOG_PROJECT_API_KEY=phc_your_project_api_key
# Optional EU host: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
# Optional: personal API key (Query read) to enrich /metrics with PostHog totals
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key
POSTHOG_PROJECT_ID=741977

# Comma-separated emails allowed to open https://aurasolve.io/metrics
ADMIN_EMAILS=you@example.com

# Local dev only
PORT=8787
